{
  "name": "portfolio-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bake": "${BPY_PYTHON:-$HOME/.bpy-venv/bin/python} blender/bake.py -- public/room; npm run compress",
    "compress": "gltf-transform meshopt public/room/room.glb public/room/room.glb && gltf-transform meshopt public/room/maxel.glb public/room/maxel.glb"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
